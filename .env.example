# Copy to .env for machine-local defaults. `./run.sh` sources it automatically.
# Do not commit .env.

# --- local Qwen via llama.cpp (recommended; no API key) ----------------------
RAG_IM_PROVIDER=local
RAG_IM_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
RAG_IM_LOCAL_MODEL=qwen3.5-2b
# llama.cpp only serves /v1/embeddings when started with --embedding.
RAG_IM_LOCAL_EMBEDDINGS=0

# --- cloud fallback: Hermes proxy (free models, no key) ----------------------
# Start it first:  hermes proxy start --port 8645
# RAG_IM_PROVIDER=hermes
# RAG_IM_HERMES_BASE_URL=http://127.0.0.1:8645/v1
# RAG_IM_HERMES_MODEL=upstage/solar-mini4:free
# RAG_IM_HERMES_EMBEDDINGS=0

# --- OpenCode Zen (free tier is rate-limited) --------------------------------
# RAG_IM_PROVIDER=opencode
# RAG_IM_OPENCODE_MODEL=deepseek-v4.1-flash-free

# --- any OpenAI-compatible endpoint with a key -------------------------------
# RAG_IM_PROVIDER=cloud
# RAG_IM_API_KEY=sk-...
# RAG_IM_BASE_URL=https://api.openai.com/v1
# RAG_IM_CHAT_MODEL=gpt-4o-mini
# RAG_IM_EMBED_MODEL=text-embedding-3-small
# RAG_IM_EMBEDDINGS=1
